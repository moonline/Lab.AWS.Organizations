{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowEditUserAndGroups",
            "Effect": "Allow",
            "Action": [
                "identitystore:UpdateGroup",
                "identitystore:UpdateUser",
                "identitystore:DeleteUser",
                "identitystore:DeleteGroupMembership",
                "identitystore:CreateGroupMembership",
                "identitystore:CreateGroup",
                "identitystore:CreateUser",
                "identitystore:DeleteGroup"
            ],
            "Resource": [
                "arn:aws:identitystore:::group/*",
                "arn:aws:identitystore:::user/*",
                "arn:aws:identitystore:::identitystore/*",
                "arn:aws:identitystore:::membership/*"
            ]
        },
        {
            "Sid": "AllowEditSsoUsers",
            "Effect": "Allow",
            "Action": [
                "sso-directory:DisableUser",
                "sso-directory:UpdateUser",
                "sso-directory:RemoveMemberFromGroup",
                "sso-directory:EnableUser",
                "sso-directory:StartVirtualMfaDeviceRegistration",
                "sso-directory:UpdatePassword",
                "sso-directory:CreateUser",
                "sso-directory:DeleteUser",
                "sso-directory:UpdateUserName",
                "sso-directory:AddMemberToGroup",
                "sso-directory:VerifyEmail",
                "sso-directory:DeleteMfaDeviceForUser",
                "sso-directory:UpdateMfaDeviceForUser",
                "sso-directory:CompleteVirtualMfaDeviceRegistration"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowEditAccountAssignment",
            "Effect": "Allow",
            "Action": [
                "sso:CreateAccountAssignment",
                "sso:DeleteAccountAssignment"
            ],
            "Resource": [
                "arn:aws:sso:::instance/*",
                "arn:aws:sso:::permissionSet/*/*",
                "arn:aws:sso:::account/*",
                "arn:aws:sso:::application/*/*"
            ]
        }
    ]
}